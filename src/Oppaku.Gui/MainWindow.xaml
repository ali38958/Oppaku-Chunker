<Window x:Class="Oppaku.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oppaku" Height="820" Width="1240"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource BgBase}"
        Foreground="{DynamicResource TxtPrimary}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Path bar -->
            <RowDefinition Height="*"/>     <!-- Main content: tree + file list -->
            <RowDefinition Height="Auto"/>  <!-- Progress panel -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             TOOLBAR
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource BorderToolbar}"
                BorderThickness="0,0,0,1"
                Height="48"
                Padding="12,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left">

                    <!-- GROUP 1: Chunking -->
                    <Button x:Name="BtnToolExtractChunks"
                            Style="{DynamicResource ToolbarBtn}"
                            Content="✂️ Extract Chunks"
                            ToolTip="Split a file or folder into chunks for transport"
                            Margin="0,0,4,0"
                            Click="BtnToolExtractChunks_Click"/>
                    <Button x:Name="BtnToolRebuild"
                            Style="{DynamicResource ToolbarBtn}"
                            Content="🧩 Insert Chunks"
                            ToolTip="Insert .oppk chunk files into a sparse rebuild file"
                            Click="BtnToolRebuild_Click"/>

                    <!-- Divider -->
                    <Border Width="1" Height="20" Background="{DynamicResource DividerToolbar}" Margin="10,0"/>

                    <!-- GROUP 2: Archive -->
                    <Button x:Name="BtnToolCreateArchive"
                            Style="{DynamicResource ToolbarBtn}"
                            Content="📦 Create Archive"
                            ToolTip="Pack a file or folder into a secure .oppaku-archive"
                            Margin="0,0,4,0"
                            Click="BtnToolCreateArchive_Click"/>
                    <Button x:Name="BtnToolExtractArchive"
                            Style="{DynamicResource ToolbarBtn}"
                            Content="📂 Extract Archive"
                            ToolTip="Extract a .oppaku-archive with zero-space hole-punching"
                            Click="BtnToolExtractArchive_Click"/>

                    <!-- Divider -->
                    <Border Width="1" Height="20" Background="{DynamicResource DividerToolbar}" Margin="10,0"/>

                    <!-- GROUP 3: Tools -->
                    <Button x:Name="BtnToolHashCheck"
                            Style="{DynamicResource ToolbarBtn}"
                            Content="🛡️ Hash Check"
                            ToolTip="Verify integrity of a rebuilt file"
                            Click="BtnToolHashCheck_Click"/>

                </StackPanel>

                <!-- THEME SELECTOR (Far Right) -->
                <Button x:Name="BtnThemeSelector"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource ToolbarBtn}"
                        Content="🎨 Theme ▾"
                        MinWidth="95"
                        ToolTip="Change application theme"
                        Click="BtnThemeSelector_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ThemeContextMenu">
                            <MenuItem x:Name="MenuThemeSandstone" Header="🏜️ Sandstone Light" Click="MenuTheme_Click" Tag="SandstoneLight"/>
                            <MenuItem x:Name="MenuThemeEspresso" Header="☕ Espresso Dark" Click="MenuTheme_Click" Tag="EspressoDark"/>
                            <MenuItem x:Name="MenuThemeObsidian" Header="🌌 Obsidian Slate" Click="MenuTheme_Click" Tag="ObsidianSlate"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             PATH BAR
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Style="{DynamicResource GhostBtn}"
                        Content="&#x2190;"
                        Width="28" Height="24"
                        FontSize="14"
                        Padding="4,2"
                        Margin="0,0,4,0"
                        Click="BtnNavBack_Click"
                        ToolTip="Go up one level"/>
                <TextBox x:Name="TxtCurrentPath"
                         Text="This PC"
                         Foreground="{DynamicResource TxtPrimary}"
                         Background="{DynamicResource BgBase}"
                         BorderBrush="{DynamicResource Border}"
                         BorderThickness="1"
                         Padding="4,2"
                         FontSize="12"
                         VerticalAlignment="Center"
                         KeyDown="TxtCurrentPath_KeyDown"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             MAIN CONTENT: LEFT TREE + RIGHT FILE LIST
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>   <!-- Splitter -->
                <ColumnDefinition Width="2*"/>  <!-- File List -->
                <ColumnDefinition Width="4"/>   <!-- Splitter 2 -->
                <ColumnDefinition Width="1.5*" MinWidth="300"/> <!-- Action Panel -->
            </Grid.ColumnDefinitions>

            <!-- Directory Tree -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,1,0">
                <TreeView x:Name="TvDirs"
                          Margin="6"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="TvDirs_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" MouseLeftButtonUp="TvItem_MouseUp" Background="Transparent">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Resize splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}"
                          Cursor="SizeWE"/>

            <!-- File List -->
            <Border Grid.Column="2" Background="{DynamicResource BgBase}">
                <ListView x:Name="LvFiles"
                          SelectionMode="Extended"
                          MouseDoubleClick="LvFiles_DoubleClick"
                          SelectionChanged="LvFiles_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name"          Width="230">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size"          Width="80"  DisplayMemberBinding="{Binding SizeDisplay}"/>
                            <GridViewColumn Header="Type"          Width="100" DisplayMemberBinding="{Binding TypeDisplay}"/>
                            <GridViewColumn Header="Date Modified" Width="140" DisplayMemberBinding="{Binding DateDisplay}"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="✂️ Extract Chunks..."    Click="BtnToolExtractChunks_Click"/>
                            <MenuItem Header="📦 Create Archive..."    Click="BtnToolCreateArchive_Click"/>
                            <Separator/>
                            <MenuItem Header="📂 Extract Archive..."   Click="BtnToolExtractArchive_Click"/>
                            <MenuItem Header="🧩 Insert Chunks..."     Click="BtnToolRebuild_Click"/>
                            <Separator/>
                            <MenuItem Header="📁 Open in Explorer"     Click="MenuOpenInExplorer_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Border>

            <!-- Resize splitter 2 -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Border}"
                          Cursor="SizeWE"/>

            <!-- Action Panel (Right Side) -->
            <Border Grid.Column="4" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <ContentControl x:Name="ActionPanel" Margin="15" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             PROGRESS / LOG PANEL (collapsible)
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                x:Name="ProgressPanel"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0" x:Name="LogRow"/>
                </Grid.RowDefinitions>

                <!-- Title + percent + cancel + toggle -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtGlobalTitle"
                               Text="Ready"
                               Foreground="{DynamicResource Accent}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtProgressPercent"
                               Grid.Column="1"
                               Text=""
                               Foreground="{DynamicResource Accent}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="8,0"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            x:Name="BtnCancelGlobalTask"
                            Style="{DynamicResource GhostBtn}"
                            Content="✕ Cancel"
                            FontSize="11"
                            Padding="8,3"
                            Margin="0,0,6,0"
                            Visibility="Collapsed"
                            Click="BtnCancelGlobalTask_Click"/>
                    <Button Grid.Column="3"
                            x:Name="BtnToggleLog"
                            Style="{DynamicResource GhostBtn}"
                            Content="Log &#x25B2;"
                            FontSize="11"
                            Padding="8,3"
                            Click="BtnToggleLog_Click"/>
                </Grid>

                <!-- Progress bar + detail -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ProgressBar x:Name="PbGlobalProgress"
                                 Minimum="0" Maximum="100"
                                 Height="4"/>
                    <TextBlock x:Name="TxtProgressDetail"
                               Grid.Row="1"
                               Text=""
                               Foreground="{DynamicResource TxtSecondary}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               FontFamily="Consolas"/>
                </Grid>

                <!-- Scrollable log -->
                <Border Grid.Row="2" Margin="0,8,0,0" x:Name="LogBorder">
                    <ListBox x:Name="LstLog"
                             Height="130"
                             Background="{DynamicResource BgBase}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource Border}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Focusable="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"     Value="2,1"/>
                                <Setter Property="Focusable"   Value="False"/>
                                <Setter Property="Background"  Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           FontFamily="Consolas"
                                           Foreground="{DynamicResource TxtSecondary}"
                                           Padding="6,1"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgToolbar}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusLeft"
                           Text="Ready"
                           Foreground="{DynamicResource TxtSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusRight"
                           Grid.Column="1"
                           Text=""
                           Foreground="{DynamicResource TxtMuted}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>
