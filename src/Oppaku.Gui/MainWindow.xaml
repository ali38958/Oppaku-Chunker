<Window x:Class="Oppaku.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oppaku - File Chunker V2" Height="600" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TabControl Grid.Row="0">
            <TabItem Header="Extract (Source -> Destination)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Source (File or Folder):"/>
                    <TextBox x:Name="TxtSourceFile" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="False" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <Button Content="File..." Width="50" Margin="5" Click="BtnBrowseSourceFile_Click"/>
                        <Button Content="Folder..." Width="60" Margin="5,5,5,5" Click="BtnBrowseSourceFolder_Click"/>
                    </StackPanel>

                    <Label Grid.Row="1" Grid.Column="0" Content="Destination Folder:"/>
                    <TextBox x:Name="TxtExtractOutput" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="False" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Width="120" Margin="5" Click="BtnBrowseExtractOutput_Click"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Chunk Size:"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="CboChunkSize" Margin="5" IsEditable="True" Width="100">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="100"/>
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="1024"/>
                        </ComboBox>
                        <ComboBox x:Name="CboChunkUnit" Margin="5" Width="60" SelectedIndex="1">
                            <ComboBoxItem Content="KB"/>
                            <ComboBoxItem Content="MB"/>
                            <ComboBoxItem Content="GB"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="BtnCalculateParts" Grid.Row="2" Grid.Column="2" Content="Calculate Parts" Margin="5" Width="120" Click="BtnCalculateParts_Click"/>
                    
                    <Label Grid.Row="3" Grid.Column="0" Content="Parts to Extract:"/>
                    <ListBox x:Name="LstParts" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" SelectionMode="Multiple">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="BtnExtract" Grid.Row="5" Grid.Column="2" Content="Extract Selected" Width="120" Margin="5" Click="BtnExtract_Click" IsEnabled="False" HorizontalAlignment="Right"/>
                </Grid>
            </TabItem>
            <TabItem Header="Rebuild (Source -> Destination)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Part File(s) (.oppk):"/>
                    <TextBox x:Name="TxtChunkFile" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="False" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Width="75" Margin="5" Click="BtnBrowseChunk_Click"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Target Location:"/>
                    <TextBox x:Name="TxtRebuildOutput" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="False" VerticalContentAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Auto" ToolTip="Select a folder for a new rebuild, or select an existing file to append a part to it."/>
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                        <Button Content="File..." Width="50" Margin="5" Click="BtnBrowseTargetFile_Click"/>
                        <Button Content="Folder..." Width="60" Margin="5,5,5,5" Click="BtnBrowseTargetFolder_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRebuild" Content="Insert Part(s)" Width="90" Margin="5" Click="BtnRebuild_Click" IsEnabled="False"/>
                        <Button x:Name="BtnFinalise" Content="Finalise" Width="90" Margin="5" Click="BtnFinalise_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Global Status / Log Area -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DBC4B6" BorderThickness="1" Margin="0,10,0,0" Padding="10">
            <StackPanel>
                <TextBlock x:Name="TxtGlobalTitle" Text="Ready" FontWeight="Bold" Foreground="#B5654A"/>
                <TextBlock x:Name="TxtGlobalMessage" Text="Waiting for user action..." Margin="0,5,0,10" TextWrapping="Wrap" Foreground="#495057"/>
                <ProgressBar x:Name="PbGlobalProgress" Height="20" Minimum="0" Maximum="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
