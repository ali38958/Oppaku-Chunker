<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ OBSIDIAN SLATE THEME TOKENS ═════════════════════════════════ -->
    <SolidColorBrush x:Key="BgBase"              Color="#0F1419"/>
    <SolidColorBrush x:Key="BgSurface"           Color="#192028"/>
    <SolidColorBrush x:Key="BgPanel"             Color="#141A21"/>
    <SolidColorBrush x:Key="BgToolbar"           Color="#0A0E12"/>
    <SolidColorBrush x:Key="BgHover"             Color="#222B36"/>
    <SolidColorBrush x:Key="BgSelected"          Color="#1C4B72"/>
    <SolidColorBrush x:Key="BgInput"             Color="#1F2833"/>
    
    <SolidColorBrush x:Key="BgToolbarBtn"        Color="#1A222B"/>
